# syntax=docker/dockerfile:1.19@sha256:b6afd42430b15f2d2a4c5a02b919e98a525b785b1aaff16747d2f623364e39b6

FROM --platform=$BUILDPLATFORM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS source
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG REGRESS_COMMIT=0328ab6828471b6a8ed3b9acb8b256e285b65abc
ARG REGRESS_ARCHIVE_SHA256=176f6140b43f9410787acc50c26f930def646b21031a93101ddc6d0bd22d565b
# The shipped-tree sanitizer and lock, held in the verifier's own Dockerfile so no verifier file repeats an agent-visible one.
COPY <<'SANITIZE_EOF' /stage/sanitize.py
"""Turn the upstream regress tree at 0328ab6 into the tree shipped to the agent.

Usage: python sanitize.py <extracted regress tree>
Removes the PikeVM backend, the regress-tool and gen-unicode workspace members, CI files, and the
commented-out duplicate-named-group backreference TODO. Every edit asserts its anchor.
"""
import re
import shutil
import sys
import pathlib

root = pathlib.Path(sys.argv[1])


def edit(rel, before, after, count=1):
    path = root / rel
    text = path.read_text()
    if text.count(before) != count:
        raise SystemExit(f"{rel}: expected {count} anchor(s), found {text.count(before)}: {before[:60]!r}")
    path.write_text(text.replace(before, after))


for rel in ("src/pikevm.rs", "regress-tool", "gen-unicode", ".github", ".gitignore"):
    path = root / rel
    if path.is_dir():
        shutil.rmtree(path)
    else:
        path.unlink()

edit("Cargo.toml", '[workspace]\nmembers = ["regress-tool", "gen-unicode", "."]\ndefault-members = ["regress-tool", "."]\n', "[workspace]\n")
edit("Cargo.toml", 'default = ["backend-pikevm", "std"]', 'default = ["std"]')
edit("Cargo.toml", "# Enables the PikeVM backend.\nbackend-pikevm = []\n\n", "")

edit("src/lib.rs", '\n#[cfg(feature = "backend-pikevm")]\nmod pikevm;\n', "\n")
edit("src/api.rs", '#[cfg(feature = "backend-pikevm")]\nuse crate::pikevm;\n', "")
edit("src/api.rs", "// Currently there is only the classical backtracking, and PikeVM.\n", "// Currently there is only the classical backtracking.\n")
edit(
    "src/api.rs",
    '    /// A Executor using the PikeVM executor.\n    #[cfg(feature = "backend-pikevm")]\n'
    "    pub type PikeVMExecutor<'r, 't> = super::pikevm::PikeVMExecutor<'r, indexing::Utf8Input<'t>>;\n\n",
    "",
)

common = "tests/common/mod.rs"
edit(common, "            // We don't test the PikeVM backend with UTF16 or UCS2.\n", "")
edit(
    common,
    '            #[cfg(feature = "backend-pikevm")]\n            (true, Backend::PikeVM) => {\n'
    "                rbe::find::<rbe::PikeVMExecutor>(&self.re, input, start).collect()\n            }\n\n"
    '            #[cfg(feature = "backend-pikevm")]\n            (false, Backend::PikeVM) => {\n'
    "                rbe::find::<rbe::PikeVMExecutor>(&self.re, input, start).collect()\n            }\n\n",
    "",
)
edit(common, '    #[cfg(feature = "backend-pikevm")]\n    PikeVM,\n', "")
text = (root / common).read_text()
# Every remaining `#[cfg(feature = "backend-pikevm")] { ... }` block in the config helpers.
pattern = re.compile(r'\n    #\[cfg\(feature = "backend-pikevm"\)\]\n    \{\n(?:        .*\n|\n)*?    \}\n')
text, n = pattern.subn("\n", text)
if n != 2:
    raise SystemExit(f"{common}: expected 2 PikeVM config blocks, removed {n}")
(root / common).write_text(text)

# The commented-out block in test_duplicate_named_groups_tc that describes the missing backreference support.
tests = (root / "tests/tests.rs").read_text()
start = tests.index("    // TODO: Backreferences with duplicate named groups require additional work")
end_anchor = '    //assert!(tc.compile(r"(?:(?<a>x)|(?<a>y))\\k<a>")'
end = tests.index(end_anchor, start)
end = tests.index("\n", tests.index(";", end)) + 1
(root / "tests/tests.rs").write_text(tests[:start] + tests[end:])

edit("src/lib.rs", ' There is also the "PikeVM" pseudo-toy backend which is mainly used for testing and verification.', "")
readme = (root / "README.md").read_text()
start = readme.index("### Fun Tools")
end = readme.index("\n## ", start)
(root / "README.md").write_text(readme[:start] + readme[end + 1 :])

leftover = [
    str(p.relative_to(root))
    for p in root.rglob("*")
    if p.is_file()
    and re.search(r"(?i)pikevm|regress-tool|gen-unicode", p.read_text(errors="ignore").replace("autogenerated from gen-unicode", ""))
]
if leftover:
    raise SystemExit(f"references left: {leftover}")
print("sanitized")
SANITIZE_EOF

COPY <<'LOCK_EOF' /stage/Cargo.lock.shipped
# This file is automatically @generated by Cargo.
# It is not intended for manual editing.
version = 4

[[package]]
name = "allocator-api2"
version = "0.2.21"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "683d7910e743518b0e34f1186f92494becacb047c7b6bf616c96772180fef923"

[[package]]
name = "equivalent"
version = "1.0.3"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "00d174d5400e5e8fd687ad1049e2f578285fa914201b1af7e8b112a4546bd826"

[[package]]
name = "foldhash"
version = "0.2.0"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "77ce24cb58228fbb8aa041425bb1050850ac19177686ea6e0f41a70416f56fdb"

[[package]]
name = "hashbrown"
version = "0.17.1"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "ed5909b6e89a2db4456e54cd5f673791d7eca6732202bbf2a9cc504fe2f9b84a"
dependencies = [
 "allocator-api2",
 "equivalent",
 "foldhash",
]

[[package]]
name = "memchr"
version = "2.8.3"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "cf8baf1c55e62ffcace7a9f06f4bd9cd3f0c4beb022d3b367256b91b87513d98"

[[package]]
name = "regress"
version = "0.12.0"
dependencies = [
 "hashbrown",
 "memchr",
]
LOCK_EOF

RUN python - <<'PY'
import hashlib, io, json, os, shutil, subprocess, tarfile, urllib.request
commit = os.environ["REGRESS_COMMIT"]
data = urllib.request.urlopen(f"https://codeload.github.com/ridiculousfish/regress/tar.gz/{commit}", timeout=600).read()
if hashlib.sha256(data).hexdigest() != os.environ["REGRESS_ARCHIVE_SHA256"]:
    raise SystemExit("regress archive digest mismatch")
with tarfile.open(fileobj=io.BytesIO(data)) as archive:
    archive.extractall("/fetch", filter="data")
shutil.move(f"/fetch/regress-{commit}", "/shipped")
subprocess.run(["python", "/stage/sanitize.py", "/shipped"], check=True)
shutil.copy("/stage/Cargo.lock.shipped", "/shipped/Cargo.lock")
src = "/shipped/src"
manifest = {}
for dirpath, _, files in os.walk(src):
    for name in files:
        path = os.path.join(dirpath, name)
        manifest[os.path.relpath(path, src)] = hashlib.sha256(open(path, "rb").read()).hexdigest()
json.dump(manifest, open("/shipped_src_manifest.json", "w"), sort_keys=True)
PY

FROM --platform=$BUILDPLATFORM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS toolchain
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG TARGETARCH
ARG RUST_VERSION=1.98.1
ARG RUST_SHA256_AMD64=5326b36c53de11d148c8f8dab6553a3d1006c2cfd32123683073fad3c302605b
ARG RUST_SHA256_ARM64=0b514a8cc1cbcd939bff0f151661fe58b6ea5c7a7f645a5098c69e32e8c1e0a2
RUN python - <<'PY'
import hashlib, os, subprocess, tarfile, urllib.request
arch = {"amd64": "x86_64", "arm64": "aarch64"}[os.environ["TARGETARCH"]]
want = os.environ["RUST_SHA256_AMD64" if arch == "x86_64" else "RUST_SHA256_ARM64"]
name = f"rust-{os.environ['RUST_VERSION']}-{arch}-unknown-linux-gnu"
data = urllib.request.urlopen(f"https://static.rust-lang.org/dist/{name}.tar.xz", timeout=1800).read()
if hashlib.sha256(data).hexdigest() != want:
    raise SystemExit("rust archive digest mismatch")
open("/rust.tar.xz", "wb").write(data)
with tarfile.open("/rust.tar.xz") as archive:
    archive.extractall("/", filter="data")
subprocess.run([f"/{name}/install.sh", "--prefix=/opt/rust", "--disable-ldconfig",
                f"--components=rustc,cargo,rust-std-{arch}-unknown-linux-gnu"], check=True)
PY

FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS vendor
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY --from=toolchain /opt/rust /opt/rust
COPY --from=source /shipped /shipped
ENV PATH=/opt/rust/bin:$PATH
RUN cargo vendor --locked --manifest-path /shipped/Cargo.toml /vendor > /vendor-config.toml \
 && rm -rf /root/.cargo

FROM --platform=$BUILDPLATFORM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS wheels
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG TARGETOS
ARG TARGETARCH
COPY requirements.lock /requirements.lock
RUN case "${TARGETARCH}" in \
      amd64) arch=x86_64 ;; \
      arm64) arch=aarch64 ;; \
      *) echo "unsupported ${TARGETOS}/${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && pip download --no-cache-dir --require-hashes --only-binary=:all: \
      --platform "manylinux_2_28_${arch}" --platform "manylinux_2_17_${arch}" --platform "manylinux2014_${arch}" --platform any \
      --python-version 3.12 --implementation cp --abi cp312 --abi abi3 --abi none \
      -r /requirements.lock -d /wheels

FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS runtime
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
LABEL org.opencontainers.image.source="https://github.com/ridiculousfish/regress" \
      org.opencontainers.image.revision="0328ab6828471b6a8ed3b9acb8b256e285b65abc" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      org.opencontainers.image.base.name="docker.io/library/python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337"
RUN groupadd --gid 1000 grader && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash grader \
 && groupadd --gid 1001 sandbox && useradd --uid 1001 --gid 1001 --no-create-home --shell /usr/sbin/nologin sandbox
RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261020T000000Z bookworm main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20261026T041303Z bookworm-security main' \
      > /etc/apt/sources.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gcc=4:12.2.0-3 libc6-dev=2.36-9+deb12u14 procps=2:4.0.2-3 \
      libssl3=3.0.22-1~deb12u2 openssl=3.0.22-1~deb12u2 \
 && rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,from=wheels,source=/wheels,target=/wheels \
    --mount=type=bind,source=requirements.lock,target=/requirements.lock \
    pip install --no-cache-dir --no-index --find-links /wheels --require-hashes -r /requirements.lock
COPY --from=toolchain /opt/rust /opt/rust
COPY --from=vendor /vendor /opt/cargo-vendor
COPY --from=vendor /vendor-config.toml /opt/grader/cargo-config.toml
COPY --from=source /shipped /opt/grader/shipped
COPY --from=source /shipped_src_manifest.json /opt/grader/shipped_src_manifest.json
COPY __grader__/harness /opt/grader/harness
COPY __grader__/cases /opt/grader/cases
COPY __grader__/refuse.py /opt/grader/refuse.py
COPY __grader__/reference/ROOT_CAUSE.md /opt/grader/reference/ROOT_CAUSE.md
COPY __grader__/fallback/reward.toml __grader__/fallback/judge.py /opt/grader/fallback/
COPY test_output.py /opt/grader/fallback/test_output.py
COPY __grader__/expected.json /opt/grader/expected.json
COPY test.sh reward.toml test_output.py judge.toml /tests/
COPY judge/prompt.md /tests/judge/prompt.md
RUN sed -i 's#directory = "/vendor"#directory = "/opt/cargo-vendor"#' /opt/grader/cargo-config.toml \
 && printf '\n[net]\noffline = true\n' >> /opt/grader/cargo-config.toml \
 && chown -R 0:0 /opt/grader /tests /opt/rust /opt/cargo-vendor \
 && chmod -R a+rX,go-w /opt/grader /tests /opt/rust /opt/cargo-vendor \
 && chown 1000:1000 /opt/grader/expected.json && chmod 0400 /opt/grader/expected.json \
 && chmod 0555 /tests/test.sh \
 && install -d -o 1000 -g 1000 /workspace /logs/verifier
ENV PATH=/opt/rust/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True
WORKDIR /workspace
USER 1000:1000
CMD ["/bin/bash"]
