# syntax=docker/dockerfile:1.19@sha256:b6afd42430b15f2d2a4c5a02b919e98a525b785b1aaff16747d2f623364e39b6

# Clamps the timestamps RUN steps write (useradd, apt, pip); the image exporter still needs it as a build argument.
# 1793510700 is the committer time of dateutil a78cbd81, 2026-11-01T05:25:00Z.
ARG SOURCE_DATE_EPOCH=1793510700

FROM --platform=$BUILDPLATFORM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS source
ARG SOURCE_DATE_EPOCH
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG DATEUTIL_COMMIT=a78cbd81d5d03b5f126eb36edb92bca78972c804
ARG DATEUTIL_ARCHIVE_SHA256=fb25686c99903d306b5d0a0a3b92c481a5843e141f0b486a193d6a9e3a4196ff
ARG SPEC_URL=https://www.rfc-editor.org/rfc/rfc5545.txt
ARG SPEC_SHA256=c256f809479d98aa23d71bbd1658b3800ea9f13f41ca56e59c8d2de1b31cbfcb
COPY overlay/src/dateutil/rrule.py overlay/src/dateutil/_version.py /stage/
RUN python - <<'PY'
import hashlib, io, os, re, shutil, tarfile, urllib.request
commit = os.environ["DATEUTIL_COMMIT"]
data = urllib.request.urlopen(f"https://codeload.github.com/dateutil/dateutil/tar.gz/{commit}", timeout=600).read()
if hashlib.sha256(data).hexdigest() != os.environ["DATEUTIL_ARCHIVE_SHA256"]:
    raise SystemExit("dateutil archive digest mismatch")
with tarfile.open(fileobj=io.BytesIO(data)) as archive:
    archive.extractall("/fetch", filter="data")
shutil.move(f"/fetch/dateutil-{commit}", "/dateutil")
for name in ("AGENTS.md", ".github", "changelog.d", "ci_tools", "codecov.yml", "RELEASING"):
    path = os.path.join("/dateutil", name)
    shutil.rmtree(path) if os.path.isdir(path) else os.remove(path)
# _version.py ships in the tree, so the ignore rule for it goes.
gitignore = open("/dateutil/.gitignore").read()
block = "# Autogenerated version information\nsrc/dateutil/_version.py\n\n"
if gitignore.count(block) != 1:
    raise SystemExit(".gitignore does not carry the _version.py rule once")
open("/dateutil/.gitignore", "w").write(gitignore.replace(block, ""))
for name in ("rrule.py", "_version.py"):
    shutil.copyfile(f"/stage/{name}", f"/dateutil/src/dateutil/{name}")
spec = urllib.request.urlopen(os.environ["SPEC_URL"], timeout=600).read()
if hashlib.sha256(spec).hexdigest() != os.environ["SPEC_SHA256"]:
    raise SystemExit("specification digest mismatch")
os.makedirs("/spec")
open("/spec/rfc5545.txt", "wb").write(spec)
# The RFC's own Copyright and License Notice, verbatim, with only the page break it straddles removed.
text = spec.decode("ascii")
notice = text.split("Copyright and License Notice\n", 1)[1].split("\nTable of Contents\n", 1)[0]
notice = re.sub(r"\n+[^\n]*\[Page \d+\]\n\f\nRFC 5545 [^\n]*\n+", "\n", notice)
notice = "\n".join(line.removeprefix("   ") for line in notice.strip("\n").split("\n"))
open("/spec/NOTICE.md", "w").write(
    "RFC 5545, Internet Calendaring and Scheduling Core Object Specification (iCalendar), September 2009,\n"
    "as published at https://www.rfc-editor.org/rfc/rfc5545.txt (sha256 " + os.environ["SPEC_SHA256"] + ").\n\n"
    "Its Copyright and License Notice reads:\n\n" + notice + "\n")
PY

FROM --platform=$BUILDPLATFORM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS wheels
ARG SOURCE_DATE_EPOCH
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG TARGETOS
ARG TARGETARCH
COPY requirements.lock /requirements.lock
# The build backend of the workspace and its dependencies. Pins resolve identically for aarch64:
#    uv pip compile build.in --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_28 --exclude-newer 2026-10-26T04:13:03Z
# where build.in holds pyproject.toml's build-system requires (hatchling>=1.27, hatch-vcs>=0.4, hatch-fancy-pypi-readme>=24.1)
# and editables~=0.3, which hatchling asks for when building an editable wheel.
COPY <<'EOF' /build-requirements.lock
editables==0.6 \
    --hash=sha256:1163834902381c4613787951c5914800fdf155ae08848a373b8ea5006780977c \
    --hash=sha256:d70e4698078a1d033e7786d9c64e5be070d058a67c21417024d38a58ac20aa43
hatch-fancy-pypi-readme==25.1.0 \
    --hash=sha256:9c58ed3dff90d51f43414ce37009ad1d5b0f08ffc9fc216998a06380f01c0045 \
    --hash=sha256:ce0134c40d63d874ac48f48ccc678b8f3b62b8e50e9318520d2bffc752eedaf3
hatch-vcs==0.5.0 \
    --hash=sha256:0395fa126940340215090c344a2bf4e2a77bcbe7daab16f41b37b98c95809ff9 \
    --hash=sha256:b49677dbdc597460cc22d01b27ab3696f5e16a21ecf2700fb01bc28e1f2a04a7
hatchling==1.32.4 \
    --hash=sha256:08ecf7548fb48205e7f213d70c71e67b8271b7242093dc3f1da578b42c734a2c \
    --hash=sha256:c4468f73144c054d2aab4ef0f0378c43b9878bf07f8ffd6b79690e970d375f07
packaging==26.3 \
    --hash=sha256:94edc256424af38762eb31306eed28beb9f0efc50a8837492c9d6fd6004aed79 \
    --hash=sha256:d7193f7c8e4e93f444fde0262bf90af30e16fa0ad0ad44cb553c87339b23cd1c
pathspec==1.1.1 \
    --hash=sha256:17db5ecd524104a120e173814c90367a96a98d07c45b2e10c2f3919fff91bf5a \
    --hash=sha256:a00ce642f577bf7f473932318056212bc4f8bfdf53128c78bbd5af0b9b20b189
pluggy==1.7.0 \
    --hash=sha256:7dd7b0d8832ba3cb632c306926ded123429211b83641b35dc5c41ad2d34f9bec \
    --hash=sha256:d1eaa46ebb595891b860ab086b4d09c8588af65ebd4361b8e8f4bb8920b90ba8
setuptools==84.2.1 \
    --hash=sha256:3ff8b3b5492a0aa66960f4419365a86b84e013070d4313e4d4a6894f5d64d6bc \
    --hash=sha256:ca140b45d5325a9478f880e351484f62fef15f336462e449ca0c03c873d589c2
setuptools-scm==10.3.4 \
    --hash=sha256:82f34c3e3084fc2b57d397200637cc13f2338004052d2fee47baa5f0e902464e \
    --hash=sha256:a69f28bfc245608781205e912faae437c2b2165773afa4e7b979d77447a69dd2
tomlkit==0.15.2 \
    --hash=sha256:05562412163a3037b94497385fb7f9204c637bc605af7a48199e41cf2272f437 \
    --hash=sha256:83e32755ba1d20d9340bd069ee97e9f6232ba2346b63ffcba425de01f7e327a6
trove-classifiers==2026.9.21.13 \
    --hash=sha256:0a9ebc8d4e2f3e8a22848c5258033035bec17a3012ac3fea16dbaa764489eb71 \
    --hash=sha256:8b1ff4f9c191b1040b71c37f1e445ab99732911e3cd91de52838453a854d7a17
vcs-versioning==2.6.0 \
    --hash=sha256:22e9159288e2d8bca2fa6f6c31c34c9c66aec157f60e9e526f5d160d2516d60f \
    --hash=sha256:f8bebd1302ebc12e67ceb30fc7dd698ec969414b6fa43b30c3f14ac9b1e72c41
