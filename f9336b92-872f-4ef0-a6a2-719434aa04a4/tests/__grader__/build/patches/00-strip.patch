-    sys.exit("America/New_York was not loaded from %s: %r" % (tzpath, zone))
-
-# Slim files have an empty version 1 data block, fat files do not.
-with open(zone._filename, "rb") as f:
-    v1_timecnt = struct.unpack(">6l", f.read(44)[20:])[3]
